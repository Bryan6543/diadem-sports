# Copy this file to .env.local and fill in the values. NEVER commit .env.local or paste it into chat.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://diademsports.lk

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string → "Session pooler" (port 5432). Used only by scripts/migrate.mjs.
SUPABASE_DB_URL=

# --- Resend (resend.com → API Keys) ---
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "Diadem Sri Lanka <hello@diademsports.lk>"
RESEND_FROM=
# Optional: Resend segment id to add newsletter contacts to (Resend → Audience → Segments)
RESEND_SEGMENT_ID=
# Where contact-form messages are delivered (defaults to the site contact email)
CONTACT_TO=

# --- Admin (/admin) ---
ADMIN_EMAIL=
# Use a long, unique password — not the same as the database password.
ADMIN_PASSWORD=
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
